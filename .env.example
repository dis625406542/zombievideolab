# No secrets in this file. Example only.
NEXT_PUBLIC_SITE_URL=https://www.zombievideolab.com
GOOGLE_SITE_VERIFICATION=

# Server-side paid video generation; enable only after Stripe, database, R2, provider and worker are configured.
# Required server-side image safety gate (Anthropic-compatible VISION model).
# Model must support two base64 images per request and thinking disabled. Failures block video submission.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=replace_with_your_vision_api_key
ANTHROPIC_MODEL=deepseek-flash

VIDEO_GENERATION_ENABLED=true
# Switch providers without touching code: poyo (default) or yir.
VIDEO_PROVIDER=yir
# Required for YIR and for signed task links to survive switching providers/restarts.
VIDEO_HANDLE_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# YIR: get a server-side API key from yir.ai. Set a hard per-job USD cost cap.
YIR_API_KEY=replace_with_your_yir_key
YIR_MAX_COST_USD=2.00
# Check GET /v1/models?include=parameters for a model supporting two reference_image
# subjects and your selected duration/resolution; the default is bytedance/seedance-2.0.
YIR_MODEL_ID=bytedance/seedance-2.0
# Set only if your model contract declares subject_references (named @Image1/@Image2).
# YIR_REFERENCE_SUBJECTS=true

# Keep this key if you want to switch back or poll an unfinished PoYo task.
# poyo_seedance_token=replace_with_your_poyo_key


# PostgreSQL (the URL may point at the postgres database; video jobs use schema zombievideolab_pro).
# Run npm run db:migrate (additive, creates tables and seeds two prices). Keep SSL configured.
DATABASE_PRO_URL=postgresql://user:password@host:5432/postgres?sslmode=verify-full
DATABASE_PRO_NAME=zombievideolab_pro
# Seedance 2.5 also supports two reference_image inputs, 8s, 480p/720p and 9:16
# on YIR's 2026-10-15 model contract. To switch: YIR_MODEL_ID=bytedance/seedance-2.5

# Private Cloudflare R2 demo playback (server-side only; NEVER use NEXT_PUBLIC_).
# Create an R2 S3 API token restricted to this bucket with Object Read & Write.
# for this demo; Object Read & Write also works if reused for later ingestion.
# Use Access Key ID + Secret Access Key, NOT the Cloudflare management API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zombievideolab
# Leave unset for global buckets; set us/eu/fedramp for jurisdictional buckets.
R2_JURISDICTION=us
R2_DEMO_VIDEO_KEY=demo1.mp4

# Comma-separated EXACT trusted provider result-media hostnames (no scheme/path).
# Required for immediate playback before R2 is ready AND background R2 copy.
# Inspect an actual provider result URL server-side and add its hostname here before testing.
# Do NOT allow *.r2.cloudflarestorage.com; use the exact provider media account host.
PROVIDER_VIDEO_HOSTS=

# One-time, hosted Stripe checkout. False or placeholder keys disable checkout.
STRIPE_ENABLED=false
# Standard (sk_test_/sk_live_) and restricted (rk_test_/rk_live_) keys are supported.
# Restricted keys need permission to read Products/Prices and create/read Checkout Sessions.
# Never expose this key to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Portal configuration is NOT required: no subscriptions or customer account portal.
# STRIPE_PORTAL_CONFIGURATION_ID=
# Background reconciliation requires a separate cron invocation, not just web requests.
CRON_SECRET=replace_with_a_separate_random_secret_at_least_32_chars
VIDEO_DAILY_SUBMISSION_LIMIT=20
# Optional direct migration URL when application DATABASE_PRO_URL uses pooling.
# DIRECT_PRO_URL=

# Development only: comma-separated exact tunnel hostnames, without scheme/path.
# Update when restarting a temporary Cloudflare tunnel; restart Next after changes.
DEV_ALLOWED_ORIGINS=frontpage-rice-stem-stripes.trycloudflare.com
